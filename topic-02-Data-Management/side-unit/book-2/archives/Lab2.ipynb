      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "nesarc_data = pd.read_csv('nesarc_pds.csv', low_memory=False)\n",
        "nesarc_data.columns = map(str.upper, nesarc_data.columns)\n",
        "\n",
        "pd.set_option('display.max_columns', None)\n",
        "pd.set_option('display.float_format', lambda x:'%f' % x)\n",
        "\n",
        "print('Rows:', len(nesarc_data))\n",
        "print('Columns:', len(nesarc_data.columns))"
      ]
