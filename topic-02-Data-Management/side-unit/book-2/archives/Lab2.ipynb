      "metadata": {
        "tags": [
          "example"
        ]
      },
      "outputs": [],
      "source": [
        "print(nesarc_data['AGE'].value_counts(sort=False))\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a5ac7e1f",
      "metadata": {
        "tags": [
          "example"
        ]
      },
      "outputs": [],
      "source": [
        "import matplotlib.pyplot as plt\n",
        "nesarc_data['AGE'].hist()\n",
        "plt.title('Age Distribution')\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "f54ee587",
      "metadata": {
        "tags": [
          "example"
        ]
      },
      "outputs": [],
      "source": [
        "print('Number of observations before filtering')\n",
        "print(len(nesarc_data))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "cba6dd97",
      "metadata": {
        "tags": [
          "example"
        ]
      },
      "outputs": [],
      "source": [
        "nesarc_data = nesarc_data[\n",
        "    (nesarc_data['AGE'] >= 18) &\n",
        "    (nesarc_data['AGE'] <= 25) &\n",
        "    (nesarc_data['CHECK321'] == 1)\n",
        "]\n",
        "\n",
        "print('Number of observations in subset')\n",
        "print(len(nesarc_data))"
      ]
